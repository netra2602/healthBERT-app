<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FB"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:overScrollMode="always"
    android:clipToPadding="false"
    android:paddingBottom="180dp">

    <LinearLayout
        android:id="@+id/dashboardRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="220dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to HealthBERT"
                    android:textColor="#1E293B"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your smart healthcare review analysis assistant"
                    android:textColor="#64748B"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileMenuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="26dp"
                    android:layout_height="3dp"
                    android:background="#1E293B" />

                <View
                    android:layout_width="26dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="7dp"
                    android:background="#1E293B" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main Feature Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Main Feature"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Analyze Healthcare Review"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter a healthcare review and HealthBERT will predict sentiment, aspect, and confidence score."
                android:textColor="#64748B"
                android:textSize="15sp" />

            <Button
                android:id="@+id/analyzeReviewButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#2563EB"
                android:text="Start Review Analysis"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/symptomSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:completionThreshold="1"
            android:hint="Search symptoms..."
            android:inputType="text"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Search"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Quick Actions"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/uploadReportButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:text="Upload Report"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/healthHistoryButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Health History"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/recentActivityButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Recent Activity"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Health Cards"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="💡 Daily Health Tip&#10;Eat balanced meals and take short walks to improve overall health."
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="💧 Water Reminder&#10;Drink 7-8 glasses of water daily."
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="💊 Medicine Reminder&#10;Take your medicine on time as prescribed."
            android:textColor="#334155"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>